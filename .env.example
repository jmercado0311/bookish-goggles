# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail para el correo semanal (contraseña de aplicación, no la normal)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Secreto compartido con el workflow de GitHub Actions del correo semanal
CRON_SECRET=

# Wompi (comercios.wompi.co → Desarrolladores). Usa las llaves pub_test_ /
# test_ para probar en sandbox y las pub_prod_ / prod_ para cobrar de verdad.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# IA de respaldo para leer extractos y auxiliares con estructura desconocida
# (console.anthropic.com → API Keys). Sin esta llave, el usuario ajusta las
# columnas a mano cuando las reglas no reconocen el archivo.
ANTHROPIC_API_KEY=

# Asistente de ventas por WhatsApp (WhatsApp Business Cloud API de Meta).
# Mientras no haya número, el asistente se prueba en Plataforma → Asistente WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v22.0
# URL pública de la app (enlaces que comparte el asistente) y correo para avisos de prospectos
NEXT_PUBLIC_APP_URL=
SALES_NOTIFY_EMAIL=
